#!/bin/sh
# flash-demo <file.py>: pack a tools/ demo WITH its dependencies and flash.
# Demos import cutebot_pro (repo root) and optionally AILens / run_controls,
# but the on-board filesystem is only ~20.6KB, so blind-copying every helper
# overflows it. Copy only the modules the demo actually imports.
set -e
cd "$(dirname "$0")/.."
[ -f "$1" ] || { echo "usage: tools/flash-demo tools/police.py"; exit 1; }
demo="$1"
tmp=$(mktemp -d)
cp cutebot_pro.py "$tmp/"
cp run_controls.py "$tmp/"
grep -q "AILens" "$demo" && cp AILens.py "$tmp/"
cp "$demo" "$tmp/main.py"
tools/mbpack "$tmp" --main main.py
rm -rf "$tmp"
